<Window x:Class="ArchMCP.Hub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArchMCP Hub v1.0.0" Height="820" Width="1280" MinHeight="680" MinWidth="1040" Icon="/ArchMCP.Hub;component/Assets/ArchMCP.ico"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,26">
                        <Image Width="38" Height="38" Source="/ArchMCP.Hub;component/Assets/ArchMCP.png" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ArchMCP" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="HUB v1.0.0 / LOCAL TOOLS" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="WorkspaceLabel" Text="WORKSPACE" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,10" />
                    <Button x:Name="OverviewNavButton" Content="Overview     ↗" Click="Overview_Click" HorizontalContentAlignment="Left" Background="#263C3B" BorderBrush="#385D58" Margin="0,0,0,6" />
                    <Button x:Name="IntegrationsNavButton" Content="Integrations" Click="Integrations_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,6" />
                    <Button x:Name="AgentsNavButton" Content="AI Agents" Click="Agents_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,6" />
                    <Button x:Name="CompatibilityNavButton" Content="Compatibility" Click="Compatibility_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,6" />
                    <Button x:Name="LogsNavButton" Content="Activity &amp; Logs" Click="Logs_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,22" />
                    <TextBlock x:Name="PreferencesLabel" Text="PREFERENCES" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,10" />
                    <Button x:Name="SettingsNavButton" Content="Settings" Click="Settings_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="11">
                        <StackPanel>
                            <TextBlock x:Name="PortableLabel" Text="PORTABLE WORKSPACE" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="PortableTitle" Text="Local-first setup" FontSize="12" Margin="0,5,0,0" />
                            <TextBlock x:Name="PortableSubtitle" Text="No cloud account required" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="© Mohamed Abd El-Hafez" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="2,12,0,5" />
                    <Button Content="Connect  ↗" Click="Connect_Click" HorizontalContentAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="2,2,2,22">
                <StackPanel>
                    <TextBlock x:Name="SectionEyebrow" Text="CONTROL CENTER" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageTitleText" Text="Your design tools, connected." FontSize="29" FontWeight="SemiBold" Margin="0,7,0,0" />
                    <TextBlock x:Name="PageSubtitleText" Text="Manage MCP integrations across your architectural workflow." FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="LanguageButton" Content="EN / عربي" Click="Language_Click" Margin="0,0,8,0" />
                    <Button x:Name="ThemeButton" Content="☼ Light mode" Click="Theme_Click" Margin="0,0,8,0" />
                    <Button x:Name="CheckEnvironmentButton" Content="Check environment" Click="CheckEnvironment_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="15" Padding="17">
                    <StackPanel>
                        <TextBlock x:Name="DesignAppsLabel" Text="DESIGN APPLICATIONS" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetectedAppsCountText" Text="0 detected" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <TextBlock x:Name="InstalledAppsSubtitle" Text="Installed host applications" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="15" Padding="17">
                    <StackPanel>
                        <TextBlock x:Name="McpConnectionsLabel" Text="MCP CONNECTIONS" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock x:Name="McpConnectionsValue" Text="5 Supported" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <TextBlock x:Name="McpStatusSubtitleText" Text="Revit, Rhino 8, 3ds Max, AutoCAD, SketchUp" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="15" Padding="17">
                    <StackPanel>
                        <TextBlock x:Name="SecurityStatusLabel" Text="SECURITY STATUS" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock x:Name="SecurityStatusValue" Text="Backup &amp; Rollback" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <TextBlock x:Name="SecurityStatusSubtitle" Text="User-level install · Safe Mode defaults" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="CoverageTitleText" Text="Integration coverage" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="CoverageSubtitleText" Text="Target hosts and their verified / installed status" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="BuildBadgeText" Text="Release v1.0.0" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3">
            <Border x:Name="HostsPanel" Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="15" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="106"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ColumnApplicationLabel" Text="APPLICATION" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="ColumnVersionLabel" Grid.Column="1" Text="VERSION" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="ColumnIntegrationLabel" Grid.Column="2" Text="DETECTION SOURCE" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="ColumnStatusLabel" Grid.Column="3" Text="STATUS" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                        <ListView x:Name="ApplicationsList" ItemsSource="{Binding Applications}" SelectionChanged="ApplicationsList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Margin="16,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding InstallPath}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallPath}" Margin="0,3,8,0"/>
                                                    <TextBlock Text="{Binding SupportNote}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding SupportNote}" Margin="0,2,8,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding VersionText}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DetectionSource}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SupportText}" Foreground="#E9C77C" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource LineBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedHostLabel" Text="SELECTED HOST / VERSION" FontSize="9" Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock x:Name="SelectedHostText" Text="Select a detected application above" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock x:Name="SelectedHostHintText" Text="Supports Revit 2022+, Rhino 7/8, 3ds Max 2021+, AutoCAD 2021+, SketchUp 2021+" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,8,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock x:Name="AgentLabel" Text="AI AGENT" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="AgentCombo" SelectedIndex="4" Height="30" SelectionChanged="AgentCombo_SelectionChanged">
                                    <ComboBoxItem Content="OpenAI Codex"/>
                                    <ComboBoxItem Content="Claude Desktop"/>
                                    <ComboBoxItem Content="Claude Code"/>
                                    <ComboBoxItem Content="Google Antigravity"/>
                                    <ComboBoxItem Content="OpenCode"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PrepareConnectionButton" Content="Install &amp; connect" Click="PrepareConnection_Click" VerticalAlignment="Center" Padding="12,8" Margin="0,0,8,0" IsEnabled="False"/>
                                <Button x:Name="UninstallConnectionButton" Content="Disable / Uninstall" Click="UninstallConnection_Click" VerticalAlignment="Center" Padding="12,8" Margin="0,0,8,0" IsEnabled="False"/>
                                <Button x:Name="RepairConnectionButton" Content="Repair" Click="RepairConnection_Click" VerticalAlignment="Center" Padding="12,8" Margin="0,0,8,0" IsEnabled="False"/>
                                <Button x:Name="VerifyConnectionButton" Content="Verify" Click="VerifyConnection_Click" VerticalAlignment="Center" Padding="12,8" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="OverviewPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="15" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="OverviewPanelTitle" Text="Environment overview" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="OverviewPanelDescription" Text="Scan your installed modeling applications, then open Integrations to install, disable/uninstall, repair, or verify MCP bridges for Revit, Rhino 8, 3ds Max, AutoCAD, and SketchUp." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <TextBlock x:Name="OverviewSummaryText" Text="Run Check environment to discover installed host versions." FontSize="14" TextWrapping="Wrap"/>
                    <Button x:Name="GoToIntegrationsButton" Content="Open integrations" Click="Integrations_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="CompatibilityPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="15" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="CompatibilityPanelTitle" Text="Compatibility policy &amp; Supported Ranges" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="CompatibilityPanelDescription" Text="Detection alone does not mean an MCP integration is verified. Live endpoint verification is required." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <TextBlock x:Name="CompatibilityVerifiedText" Text="• Verified — Files installed, agent registered, and live in-host health check responded." TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock x:Name="CompatibilityInstalledText" Text="• InstalledAwaitingHost — MCP server and plugin files installed on disk; open the CAD host to verify live connection." TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock x:Name="CompatibilityUntestedText" Text="• Untested — Compatible host executable detected, but integration has not been installed/verified yet." TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock x:Name="CompatibilityUnsupportedText" Text="• Unsupported — Host version is outside the upstream MCP server's supported range (e.g., Revit 2021, Rhino 6, 3ds Max 2020)." TextWrapping="Wrap" Margin="0,4"/>
                    <Button x:Name="CompatibilityOpenIntegrationsButton" Content="View detected versions" Click="Integrations_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="AgentsPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="15" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="AgentsPanelTitle" Text="Supported AI Agents" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="AgentsPanelDescription" Text="ArchMCP Hub preserves existing user configurations and creates timestamped backups before registering MCP servers." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <ItemsControl>
                        <ItemsControl.Items>
                            <TextBlock Text="• OpenCode — CLI registration (opencode mcp add --global) + ~/.config/opencode/opencode.json preservation" Margin="0,6"/>
                            <TextBlock Text="• Claude Desktop — %LOCALAPPDATA%\Claude-Data\claude_*\claude_desktop_config.json &amp; %APPDATA%\Claude\claude_desktop_config.json (mcpServers merge with backup)" Margin="0,6"/>
                            <TextBlock Text="• Claude Code — CLI (claude mcp add --scope user) + ~/.claude.json preservation" Margin="0,6"/>
                            <TextBlock Text="• OpenAI Codex — CLI (codex mcp add) + ~/.codex/config.toml ([mcp_servers.&lt;name&gt;] section merge)" Margin="0,6"/>
                            <TextBlock Text="• Google Antigravity — ~/.gemini/config/mcp_config.json &amp; ~/.gemini/antigravity/mcp_config.json (mcpServers merge with backup)" Margin="0,6"/>
                        </ItemsControl.Items>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border x:Name="LogsPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="15" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="LogsPanelTitle" Text="Activity &amp; Diagnostics" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LogsPanelDescription" Text="Environment scan results, installer transcripts, and startup diagnostics." Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,14"/>
                    <TextBlock x:Name="LastScanText" Text="No scan has run yet." TextWrapping="Wrap"/>
                    <Button x:Name="OpenLogsButton" Content="Open diagnostic log folder" Click="OpenLogs_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="15" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="SettingsPanelTitle" Text="Preferences" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="SettingsPanelDescription" Text="Appearance and language preferences." Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,18"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SettingsThemeButton" Content="Toggle light/dark theme" Click="Theme_Click" Margin="0,0,10,0"/>
                        <Button x:Name="SettingsLanguageButton" Content="Switch English / Arabic" Click="Language_Click"/>
                    </StackPanel>
                    <TextBlock Text="© Mohamed Abd El-Hafez" Foreground="{DynamicResource MutedTextBrush}" Margin="0,24,0,0"/>
                </StackPanel>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
